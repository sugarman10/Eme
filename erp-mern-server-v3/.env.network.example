# ========================================
# ERP System - Network Configuration
# ========================================

# 📡 NETWORK SETTINGS
# Replace YOUR_IP with your actual IPv4 address
# Find it using: ipconfig (look for IPv4 Address)

# Server Configuration
PORT=4000
HOST=0.0.0.0

# MongoDB Connection
MONGODB_URI=mongodb://localhost:27017/erp_system

# CORS Origins - Add your network IP address here
# Example: CORS_ORIGINS=http://localhost:5173,http://192.168.1.100:5173
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# JWT Configuration
JWT_SECRET=your_super_secret_jwt_key_change_in_production_min_32_chars

# Environment
NODE_ENV=development

# File Upload
UPLOAD_DIR=uploads
MAX_FILE_SIZE=10485760

# Session
SESSION_SECRET=your_session_secret_key_min_32_chars

# ========================================
# INSTRUCTIONS:
# 1. Find your IP: ipconfig
# 2. Replace YOUR_IP in CORS_ORIGINS with your actual IP
# 3. Example: CORS_ORIGINS=http://localhost:5173,http://192.168.1.100:5173
# ========================================
